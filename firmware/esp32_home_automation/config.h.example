/**
 * =========================================================================
 * CONFIGURATION TEMPLATE: ESP32 Home Automation Node
 * Copy this file to "config.h" and adjust with your local network settings.
 * DO NOT commit config.h containing real passwords to public repositories.
 * =========================================================================
 */

#ifndef CONFIG_H
#define CONFIG_H

// 1. Wi-Fi Settings
const char* WIFI_SSID     = "YOUR_WIFI_SSID";
const char* WIFI_PASSWORD = "YOUR_WIFI_PASSWORD";

// 2. Backend Server Settings
// NOTE: "localhost" or "127.0.0.1" CANNOT be reached from ESP32.
// Use your computer's local network LAN IP (e.g. http://192.168.1.50:8080)
const char* BACKEND_BASE_URL = "http://192.168.1.100:8080";

// 3. Device Identification & Token Credentials
// Each device matches a registered device in the Spring Boot backend
const char* DEVICE_KEY   = "ESP32_RELAY_01";       // Primary controller device key
const char* DEVICE_TOKEN = "sec_lr_light_9921";     // Secret device authentication token

// 4. Multi-Relay Configuration on this ESP32 Node
// Configured for 4-Channel 5V Relay Module with optocoupler isolation
#define NUM_RELAYS 4

struct RelayMapping {
    const char* deviceKey;
    const char* deviceToken;
    int pin;
    int channel;
    const char* name;
};

// Safe GPIO Pin Assignments (Avoid GPIO 6-11, 34-39, 0, 2)
const RelayMapping RELAYS[NUM_RELAYS] = {
    { "ESP32_RELAY_01", "sec_lr_light_9921", 26, 1, "Living Room Light" },
    { "ESP32_RELAY_02", "sec_br_light_7732", 25, 2, "Bedroom Light" },
    { "ESP32_RELAY_03", "sec_lr_fan_4418",   33, 3, "Living Room Fan" },
    { "ESP32_RELAY_04", "sec_br_fan_6654",   32, 4, "Bedroom Fan" }
};

// 5. Electrical Relay Logic
// Most 5V optocoupler relay boards (Songle, etc.) are ACTIVE-LOW (LOW = ON, HIGH = OFF)
// Set to true for active-low, false for active-high.
const bool RELAY_ACTIVE_LOW = true;

// 6. Timing Intervals (in milliseconds)
const unsigned long POLL_INTERVAL_MS      = 1500;  // Poll backend for pending commands every 1.5s
const unsigned long HEARTBEAT_INTERVAL_MS = 10000; // Send telemetry/heartbeat every 10s
const unsigned long WIFI_RECONNECT_MS     = 5000;  // Non-blocking WiFi retry every 5s

#endif // CONFIG_H
